# GENERATED by `bun run emit:host-config` from src/lib/hosts.ts. Do not edit.
# One build, two hostnames. Copy build/ to /srv/omarchy-widgets/build.

https://example.com {
	root * /srv/omarchy-widgets/build
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	@oldDocs path /docs /docs/*
	handle @oldDocs {
		route {
			uri strip_prefix /docs
			redir https://docs.example.com{uri} 308
		}
	}
	handle {
		file_server
	}
	handle_errors {
		@badRequest expression {http.error.status_code} == 400
		handle @badRequest {
			rewrite * /400/index.html
			file_server
		}
		@serverError expression {http.error.status_code} >= 500
		handle @serverError {
			rewrite * /500/index.html
			file_server
		}
		rewrite * /404.html
		file_server
	}
}

https://docs.example.com {
	root * /srv/omarchy-widgets/build
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	@home path /
	handle @home {
		route {
			uri replace / /next/start/what-it-is/ 1
			redir https://docs.example.com{uri} 302
		}
	}
	@oldDocs path /docs /docs/*
	handle @oldDocs {
		route {
			uri strip_prefix /docs
			redir https://docs.example.com{uri} 308
		}
	}
	@wasm path_regexp ^/pagefind/wasm\..*\.pagefind$
	header @wasm Content-Type application/wasm
	@pfbin path_regexp ^/pagefind/.*\.pf_[a-z]+$
	header @pfbin Content-Type application/octet-stream
	@static path /_app/* /pagefind/* /400/* /404/* /500/* /favicon.svg /theme-boot.js /robots.txt
	handle @static {
		file_server
	}
	handle {
		rewrite * /docs{path}
		file_server
	}
	handle_errors {
		@badRequest expression {http.error.status_code} == 400
		handle @badRequest {
			rewrite * /400/index.html
			file_server
		}
		@serverError expression {http.error.status_code} >= 500
		handle @serverError {
			rewrite * /500/index.html
			file_server
		}
		rewrite * /404.html
		file_server
	}
}

# Any other Host header: 421, nothing is served.
http://:80 {
