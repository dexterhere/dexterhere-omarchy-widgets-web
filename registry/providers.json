{
  "schemaVersion": 0,
  "providers": {
    "system": {
      "class": "local-system",
      "auth": "none",
      "egress": [],
      "topics": {
        "system.time": ["hm", "hms", "date", "tz"],
        "system.cpu": ["load", "usage_pct"],
        "system.memory": ["used", "total", "used_pct"],
        "system.temp": ["celsius"]
      }
    },
    "battery": {
      "class": "local-system",
      "auth": "none",
      "egress": [],
      "topics": {
        "battery.status": ["percent", "state", "timeLeft"]
      }
    },
    "github": {
      "class": "personal",
      "auth": "vault",
      "egress": ["api.github.com"],
      "topics": {
        "github.prs": ["open", "review"]
      }
    },
    "docker": {
      "class": "host-control",
      "auth": "none",
      "egress": [],
      "topics": {
        "docker.containers": ["running", "stopped", "unhealthy", "names"]
      }
    },
    "ai-usage": {
      "class": "private-content",
      "auth": "none",
      "egress": [],
      "topics": {
        "ai-usage.sessions": ["sessions", "requests", "activeMinutes"]
      }
    },
    "tasks": {
      "class": "personal",
      "auth": "none",
      "egress": [],
      "topics": {
        "tasks.list": ["open", "dueToday", "titles"]
      }
    }
  }
}
