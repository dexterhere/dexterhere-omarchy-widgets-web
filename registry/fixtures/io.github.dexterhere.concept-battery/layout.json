{
  "schemaVersion": 0,
  "root": {
    "type": "row",
    "gap": "md",
    "children": [
      {
        "type": "ring",
        "bind": {
          "topic": "battery.status",
          "field": "percent"
        },
        "color": "accent"
      },
      {
        "type": "stack",
