            "color": "accent"
          },
          {
            "type": "text",
            "bind": {
              "topic": "battery.status",
              "field": "state"
            },
            "size": "sm",
            "color": "muted"
          },
          {
            "type": "text",
            "bind": {
              "topic": "battery.status",
              "field": "timeLeft"
            },
            "size": "sm",
            "color": "secondary"
          }
        ]
      }
    ]
