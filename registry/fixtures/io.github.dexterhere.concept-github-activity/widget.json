{
  "schemaVersion": 0,
  "id": "io.github.dexterhere.concept-github-activity",
  "tier": "spec",
  "category": "dev-git",
  "surfaces": ["desktop"],
  "sizeClasses": [
    {
      "name": "compact",
      "min": [160, 100],
      "max": [240, 160],
      "aspectLock": null
    },
    {
      "name": "wide",
      "min": [280, 120],
      "max": [480, 200],
      "aspectLock": null
    }
  ],
  "variants": ["list", "counts"],
  "providers": [
    {
      "name": "github",
      "topics": ["github.prs"],
      "fields": ["open", "review"],
      "auth": "vault"
    }
  ],
  "capabilities": {
    "network": ["api.github.com"],
    "files": [],
    "spawn": []
  },
  "interactiveRegions": [],
  "settings": [
    {
      "key": "interval",
      "type": "int",
      "label": "Refresh interval (seconds)",
      "default": 60,
      "min": 30,
      "max": 600
    }
  ],
  "compat": {
    "omarchy": ">=4.0",
    "widgetsKit": "^1"
  },
  "sampleData": {
    "github.prs": {
      "open": 4,
      "review": 2
    }
  }
}
