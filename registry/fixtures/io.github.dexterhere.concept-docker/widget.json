{
  "schemaVersion": 0,
  "id": "io.github.dexterhere.concept-docker",
  "tier": "spec",
  "category": "network-containers",
  "surfaces": ["desktop"],
  "sizeClasses": [
    {
      "name": "compact",
      "min": [160, 100],
      "max": [240, 160],
      "aspectLock": null
    },
    {
      "name": "wide",
      "min": [280, 120],
      "max": [480, 200],
      "aspectLock": null
    }
  ],
  "variants": ["counts", "list"],
  "providers": [
    {
      "name": "docker",
      "topics": ["docker.containers"],
      "fields": ["running", "stopped", "unhealthy", "names"],
      "auth": "none"
    }
  ],
  "capabilities": {
    "network": [],
    "files": ["/run/docker.sock"],
    "spawn": []
  },
  "interactiveRegions": [],
  "settings": [
    {
      "key": "interval",
      "type": "int",
      "label": "Refresh interval (seconds)",
      "default": 10,
      "min": 2,
      "max": 300
    }
  ],
  "compat": {
    "omarchy": ">=4.0",
    "widgetsKit": "^1"
  },
  "sampleData": {
    "docker.containers": {
      "running": 5,
      "stopped": 2,
      "unhealthy": 0,
      "names": ["web", "db", "cache"]
    }
  }
}
