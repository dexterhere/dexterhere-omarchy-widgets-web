{
  "schemaVersion": 0,
  "id": "io.github.dexterhere.concept-system-monitor",
  "tier": "spec",
  "category": "system",
  "surfaces": ["desktop", "bar"],
  "sizeClasses": [
    {
      "name": "compact",
      "min": [160, 100],
      "max": [240, 160],
      "aspectLock": null
    },
    {
      "name": "wide",
      "min": [280, 120],
      "max": [480, 200],
      "aspectLock": null
    }
  ],
  "variants": ["rings", "graph"],
  "providers": [
    {
      "name": "system",
      "topics": ["system.cpu", "system.memory", "system.temp"],
      "fields": ["load", "used", "total", "celsius"],
      "auth": "none"
    }
  ],
  "capabilities": {
    "network": [],
    "files": [],
    "spawn": []
  },
  "interactiveRegions": [],
  "settings": [
    {
      "key": "interval",
      "type": "int",
      "label": "Refresh interval (seconds)",
      "default": 2,
      "min": 1,
      "max": 60
    }
  ],
  "compat": {
    "omarchy": ">=4.0",
    "widgetsKit": "^1"
  },
  "sampleData": {
    "system.cpu": {
      "load": 34
    },
    "system.memory": {
      "used": 9.2,
      "total": 16
    },
    "system.temp": {
      "celsius": 54
    }
  }
}
