{
  "schemaVersion": 0,
  "root": {
    "type": "stack",
    "gap": "sm",
    "children": [
      {
        "type": "row",
        "gap": "md",
        "children": [
          {
            "type": "icon",
            "name": "cpu",
            "color": "accent"
          },
          {
            "type": "value",
            "bind": {
              "topic": "system.cpu",
              "field": "load"
            },
            "unit": "%",
            "size": "lg",
            "color": "accent"
          }
        ]
      },
      {
        "type": "bar",
        "bind": {
          "topic": "system.cpu",
          "field": "load"
        },
        "color": "accent"
      },
      {
        "type": "row",
        "gap": "md",
        "children": [
          {
            "type": "text",
            "text": "Memory",
            "size": "sm",
            "color": "muted"
          },
          {
            "type": "value",
            "bind": {
              "topic": "system.memory",
              "field": "used"
            },
            "unit": "G",
            "size": "md",
            "color": "foreground"
          }
        ]
      },
      {
        "type": "row",
        "gap": "md",
        "children": [
          {
            "type": "text",
            "text": "Temp",
            "size": "sm",
            "color": "muted"
          },
          {
            "type": "value",
            "bind": {
              "topic": "system.temp",
              "field": "celsius"
            },
            "unit": "C",
            "size": "md",
            "color": "foreground"
          }
        ]
      }
