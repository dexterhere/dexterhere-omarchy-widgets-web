{
  "schemaVersion": 0,
  "id": "io.github.dexterhere.concept-tasks",
  "tier": "spec",
  "category": "productivity",
  "surfaces": ["desktop"],
  "sizeClasses": [
    {
      "name": "compact",
      "min": [160, 100],
      "max": [240, 160],
      "aspectLock": null
    },
    {
      "name": "wide",
      "min": [280, 120],
      "max": [480, 200],
      "aspectLock": null
    }
  ],
  "variants": ["list", "counts"],
  "providers": [
    {
      "name": "tasks",
      "topics": ["tasks.list"],
      "fields": ["open", "dueToday", "titles"],
      "auth": "none"
    }
  ],
  "capabilities": {
    "network": [],
    "files": ["~/.local/share/omarchy-widgets/tasks.json"],
    "spawn": []
  },
  "interactiveRegions": [],
  "settings": [
    {
      "key": "maxItems",
      "type": "int",
      "label": "Items to show",
      "default": 5,
      "min": 1,
      "max": 20
    }
  ],
  "compat": {
    "omarchy": ">=4.0",
    "widgetsKit": "^1"
  },
  "sampleData": {
    "tasks.list": {
      "open": 6,
      "dueToday": 2,
      "titles": ["Reply to review", "Fix clock drift", "Write docs"]
    }
  }
}
