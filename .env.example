# Optional. Set BOTH to serve the docs on their own host from one build (see deploy/README.md).
# Leave both unset for the default: everything on one host, docs under /docs/.
# Origins only: http(s)://host[:port], no path, query or credentials. Different hostnames.
# Local: bun run build:hosts / bun run serve:local set these for you (docs.localhost).
PUBLIC_SITE_ORIGIN=http://localhost:4300
PUBLIC_DOCS_ORIGIN=http://docs.localhost:4300
